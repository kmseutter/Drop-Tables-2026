{
  "name": "Doomstopper",
  "description": "A minimal extension that opens a popup saying Hello Extensions when you click its toolbar icon.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_icon": "d.png",
    "default_popup": "hello.html"
  },
  "permissions": [
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.wikipedia.org/*", "https://*.tiktok.com/*"],
      "js": ["content.js"]
    }
  ]
}
