{
  "name": "Doomstopper",
  "description": "A minimal extension that opens a popup saying Hello Extensions when you click its toolbar icon.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_icon": "d.png",
    "default_popup": "hello.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["quiz.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "alarms",
    "tabs",
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
