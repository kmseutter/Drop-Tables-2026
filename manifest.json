{
  "name": "Doomstopper",
  "description": "An extension that opens a quiz after the user has been on a page for a long time.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_icon": "d.png",
    "default_popup": "hello.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["quiz.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "alarms",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.wikipedia.org/*", "https://*.tiktok.com/*"],
      "js": ["content.js"]
    }
  ]
}
